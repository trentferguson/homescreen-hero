# homescreen-hero Environment Variables
# Copy this file to .env and fill in your sensitive values

# ============================================
# GENERAL SETTINGS
# ============================================
# Port to run the web UI on (defaults to 8000)
HSH_PORT=8000

# ============================================
# PLEX CONFIGURATION
# ============================================
# Your Plex server URL (e.g., http://192.168.1.100:32400)
HSH_PLEX_URL=http://your-plex-server:32400

# Your Plex authentication token
# Get this from: https://support.plex.tv/articles/204059436-finding-an-authentication-token-x-plex-token/
HSH_PLEX_TOKEN=your-plex-token-here

# ============================================
# AUTHENTICATION (if auth.enabled = true)
# ============================================
# Password for web UI login (can be plaintext or bcrypt hash)
# If plaintext, it will be hashed on first use
HSH_AUTH_PASSWORD=your-secure-password-here

# Secret key for JWT token signing (generate a random string)
HSH_AUTH_SECRET_KEY=your-secret-key-here

# ============================================
# TRAKT INTEGRATION (if trakt.enabled = true)
# ============================================
# Your Trakt application client ID
# Get this from: https://trakt.tv/oauth/applications
HSH_TRAKT_CLIENT_ID=your-trakt-client-id-here

# ============================================
# MDBLIST INTEGRATION (if mdblist.enabled = true)
# ============================================
# Your MDBList API key
# Get this from: https://mdblist.com/preferences/
# Free tier: 1,000 requests per day
HSH_MDBLIST_API_KEY=your-mdblist-api-key-here

# ============================================
# TAUTULLI INTEGRATION (if tautulli.enabled = true)
# ============================================
# Your Tautulli API key
# Get this from: Tautulli Settings → Web Interface → API → API Key
HSH_TAUTULLI_API_KEY=your-tautulli-api-key-here

# Optional: Your Tautulli instance URL (defaults to http://localhost:8181)
# HSH_TAUTULLI_BASE_URL=http://your-tautulli-server:8181

# ============================================
# TMDB INTEGRATION (if tmdb.enabled = true)
# ============================================
# Your TMDb API key (v3 auth)
# Get this from: https://www.themoviedb.org/settings/api
HSH_TMDB_API_KEY=your-tmdb-api-key-here

# ============================================
# MYANIMELIST INTEGRATION (if mal.enabled = true)
# ============================================
# Your MAL API Client ID
# Get this from: https://myanimelist.net/apiconfig
HSH_MAL_CLIENT_ID=your-mal-client-id-here

# ============================================
# SEERR INTEGRATION (if seerr.enabled = true)
# ============================================
# Your Seerr/Jellyseerr/Overseerr API key
# Get this from: Seerr Settings → General → API Key
HSH_SEERR_API_KEY=your-seerr-api-key-here

# Optional: Your Seerr instance URL (defaults to http://localhost:5055)
# HSH_SEERR_BASE_URL=http://your-seerr-server:5055
